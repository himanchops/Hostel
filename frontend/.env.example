# Frontend environment variables.
#
# Copy to .env.local for local dev, or set them in Vercel's project settings
# for production (Settings → Environment Variables).
#
# NEXT_PUBLIC_ variables are inlined into the client bundle at build time and
# are therefore PUBLIC. Never put a secret here — anything the browser needs is
# something anyone can read.

# ─────────────────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED in production. Where the Go backend lives, with no trailing slash.
# Defaults to http://localhost:8080 when unset, which is what you want locally
# and never what you want deployed — if this is missed on Vercel, the app
# builds fine and every request then fails in the browser against localhost.
#
# Production example: https://hostel-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────────────
# Error tracking
# ─────────────────────────────────────────────────────────────────────────

# Optional everywhere, and unset is a supported state: with no DSN the SDK is
# never initialised and reportError() just logs to the console, exactly as it
# did before error tracking existed.
#
# This is a DSN, not a secret in the usual sense — it is inlined into the client
# bundle and anyone can read it. It grants permission to *send* events, not to
# read them, which is why publishing it is how browser error tracking works at
# all. The consequence is that someone can spam your quota with junk events; if
# that ever happens, rotate the key in the Sentry project settings.
#
# Set this in Vercel → Settings → Environment Variables (Production).
# Example: https://<publicKey>@o<org>.ingest.de.sentry.io/<projectId>
NEXT_PUBLIC_SENTRY_DSN=

# Which environment events are filed under. Set to "production" on Vercel;
# leaving it unset locally means local crashes never pollute the production
# issue list even if you paste a real DSN into .env.local to test.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# NEXT_PUBLIC_COMMIT_SHA is NOT set by hand — next.config.ts derives it from
# Vercel's VERCEL_GIT_COMMIT_SHA so that each release is tagged automatically.
