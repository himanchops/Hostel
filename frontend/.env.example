# Frontend environment variables.
#
# Copy to .env.local for local dev, or set them in Vercel's project settings
# for production (Settings → Environment Variables).
#
# NEXT_PUBLIC_ variables are inlined into the client bundle at build time and
# are therefore PUBLIC. Never put a secret here — anything the browser needs is
# something anyone can read.

# ─────────────────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED in production. Where the Go backend lives, with no trailing slash.
# Defaults to http://localhost:8080 when unset, which is what you want locally
# and never what you want deployed — if this is missed on Vercel, the app
# builds fine and every request then fails in the browser against localhost.
#
# Production example: https://hostel-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080
