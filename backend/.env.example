# Backend environment variables.
#
# Copy to .env for local dev (godotenv auto-loads it), or paste these into
# your hosting provider's dashboard for production.
#
# Anything marked REQUIRED must be set on Render (or whichever host you use).
# Anything marked LOCAL ONLY can be ignored in production.

# ─────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED (production). Single connection string from Neon / Render Postgres / Supabase.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# When set, the per-field DB_* vars below are ignored.
DATABASE_URL=

# LOCAL ONLY. Used by the local docker-compose Postgres when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_USER=hostel
DB_PASSWORD=hostel_dev
DB_NAME=hostel
DB_SSLMODE=disable

# ─────────────────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. Random string used to sign JWTs. Render auto-generates this if you
# use render.yaml. For local dev, the default below is fine.
JWT_SECRET=dev-secret-change-in-production

# ─────────────────────────────────────────────────────────────────────────
# CORS / URL building
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. The public URL of the frontend; used to allow CORS requests.
FRONTEND_URL=http://localhost:3000

# Used to build file URLs when STORAGE_BACKEND=local. Ignored for S3.
BASE_URL=http://localhost:8080

# Server listens on this port. Render sets PORT automatically.
PORT=8080

# ─────────────────────────────────────────────────────────────────────────
# File storage
# ─────────────────────────────────────────────────────────────────────────

# "s3" → Cloudflare R2 / AWS S3 / MinIO. Anything else → local disk.
STORAGE_BACKEND=

# Required when STORAGE_BACKEND=s3:
S3_ENDPOINT=         # https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=           # bucket name
S3_ACCESS_KEY=       # R2 API token access key
S3_SECRET_KEY=       # R2 API token secret
S3_PUBLIC_URL=       # https://pub-<hash>.r2.dev or your custom domain
S3_REGION=auto       # "auto" for R2, "us-east-1" etc. for AWS

# LOCAL ONLY. Where LocalStorage writes uploaded files.
UPLOADS_DIR=./uploads
